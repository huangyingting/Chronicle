generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================================
// NEXTAUTH & INVITE-ONLY ACCOUNT ADMISSION MODELS
// ============================================================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordCredential {
  id                String    @id @default(uuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  resetTokenHash    String?   @unique
  resetExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resetExpiresAt])
}

model PendingRegistration {
  id              String   @id @default(uuid())
  email           String
  normalizedEmail String   @unique
  name            String?
  passwordHash    String
  tokenHash       String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model AccountInvitation {
  id              String    @id @default(uuid())
  email           String
  normalizedEmail String
  activeForEmail  String?   @unique
  tokenHash       String?   @unique
  status          String    @default("PENDING") // "PENDING" | "ACCEPTED" | "REVOKED" | "EXPIRED"
  invitedById     String?
  acceptedById    String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  invitedBy  User?                @relation("AccountInvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?                @relation("AccountInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  emails     AccountEmailOutbox[]

  @@index([status, expiresAt])
  @@index([normalizedEmail, createdAt])
  @@index([invitedById])
  @@index([acceptedById])
}

model AccountEmailOutbox {
  id            String    @id @default(uuid())
  payload       String
  status        String    @default("pending")
  claimToken    String?
  lastAttemptAt DateTime?
  lastError     String?
  sentAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  invitationId  String?

  invitation AccountInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invitationId])
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  emailVerified    DateTime?
  name             String            @default("Alex Rivera")
  image            String?
  role             String            @default("Admin") // "Admin" | "Creator" | "Viewer"
  passwordHash     String?
  fullName         String            @default("Alex Rivera")
  picture          String?
  onboardingStatus String            @default("COMPLETED")
  userConfigJson   String            @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  passwordCredential         PasswordCredential?
  accountInvitationsSent     AccountInvitation[] @relation("AccountInvitationInviter")
  accountInvitationsAccepted AccountInvitation[] @relation("AccountInvitationAcceptor")
  memberships      WorkspaceMember[]
  documents        Document[]
  apiKeys          ApiKey[]
  museSessions     MuseChatSession[]
}

model Workspace {
  id                  String            @id @default(uuid())
  name                String
  slug                String            @unique
  icon                String?
  pricingPlanId       String            @default("e2860a7b-6550-4573-a1a0-bde7508be48b")
  defaultThemeId      String?
  apiKeyCreationScope String            @default("ALL_MEMBERS")
  tokensUsed          Int               @default(12)
  tokensLimit         Int               @default(2000)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  members             WorkspaceMember[]
  folders             Folder[]
  documents           Document[]
  themes              Theme[]
  brandKits           BrandKit[]
  mediaAssets         MediaAsset[]
  apiKeys             ApiKey[]
  museSessions        MuseChatSession[]
  customFonts         CustomFont[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("OWNER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Folder {
  id          String     @id @default(uuid())
  workspaceId String
  name        String
  parentId    String?
  scope       String     @default("WORKSPACE")
  isShared    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   Document[]
}

model Document {
  id                                 String    @id @default(uuid())
  workspaceId                        String
  authorId                           String?
  folderId                           String?
  title                              String
  scope                              String    @default("WORKSPACE")
  workspaceAccess                    String    @default("EDIT")
  isPublic                           Boolean   @default(true)
  isPublicDocumentDuplicationEnabled Boolean   @default(true)
  showWatermark                      Boolean   @default(false)
  themeId                            String?
  brandKitId                         String?
  previewUrl                         String?
  viewCount                          Int       @default(142)
  sortOrder                          Int       @default(0)
  slidesJson                         String
  collaboratorsJson                  String    @default("[]")
  deletedAt                          DateTime?
  deletedBy                          String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
  workspace                          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author                             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  folder                             Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model Theme {
  id          String     @id @default(uuid())
  workspaceId String?
  name        String
  isCustom    Boolean    @default(false)
  isDefault   Boolean    @default(false)
  dataJson    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BrandKit {
  id          String     @id @default(uuid())
  workspaceId String?
  name        String
  isDefault   Boolean    @default(false)
  colorsJson  String
  logosJson   String
  themesJson  String
  fontsJson   String     @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CustomFont {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  family      String
  weight      String    @default("400")
  style       String    @default("normal")
  url         String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id          String    @id @default(uuid())
  workspaceId String
  url         String
  type        String    @default("IMAGE")
  source      String    @default("UPLOAD")
  mediaAccess String    @default("WORKSPACE")
  fileName    String
  dimensions  String    @default("{\"width\":1920,\"height\":1080}")
  colors      String    @default("[\"#0d2238\",\"#7c5cff\"]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Template {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  author      String   @default("Chronicle")
  category    String
  previewUrl  String
  themeId     String?
  slidesJson  String
  createdAt   DateTime @default(now())
}

model MuseChatSession {
  id           String    @id @default(uuid())
  workspaceId  String
  userId       String?
  name         String
  prompt       String
  style        String    @default("Midnight")
  slideCount   Int       @default(8)
  outlineJson  String
  messagesJson String
  documentId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  name        String
  maskedKey   String
  rawKeyHash  String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
