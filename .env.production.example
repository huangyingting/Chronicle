# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production Deployment (PostgreSQL)
# Run `npm run db:use:postgres` and set:
# DATABASE_URL="postgresql://user:password@localhost:5432/chronicle_prod?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-production-nextauth-secret"
ACCOUNT_ADMISSION_MODE="invitation-only"

# Azure OpenAI (Muse AI Storyline Generator, 16:9 Slide & Widget Synthesis, Inline Muse Copilot)
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# Azure Speech / Optional Media Providers
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastus"
AZURE_SPEECH_VOICE="en-US-AndrewMultilingualNeural"
AZURE_SPEECH_OUTPUT_FORMAT="audio-24khz-96kbitrate-mono-mp3"
